rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasSubmittedDrawing(date) {
      return exists(/databases/$(database)/documents/rounds/$(date)/players/$(request.auth.uid))
        && get(/databases/$(database)/documents/rounds/$(date)/players/$(request.auth.uid)).data.hasSubmittedDrawing == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false;
    }

    match /daily/{date} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /rounds/{date}/players/{drawerId} {
      allow read: if isSelf(drawerId) || hasSubmittedDrawing(date);
      allow create, update: if isSelf(drawerId);
      allow delete: if false;

      // The drawer's secret word lives here, readable/writable only by its
      // owner. The submitGuess callable reads it via the admin SDK (rules
      // don't apply to admin), so guessers never see the answer.
      match /private/{doc} {
        allow read, write: if isSelf(drawerId);
      }
    }

    match /rounds/{date}/guesses/{guessId} {
      // `resource == null` allows a `get` on a not-yet-created guess doc
      // (returns empty), so the guessing screen and the widget can check
      // "have I guessed this friend yet?" without a PERMISSION_DENIED. Once
      // the doc exists, only its guesser or drawer may read it.
      allow read: if isSignedIn()
        && (resource == null
            || request.auth.uid == resource.data.guesserId
            || request.auth.uid == resource.data.drawerId);
      // Guesses are written ONLY by the submitGuess callable (admin SDK), which
      // validates correctness server-side, so clients can't create/forge/tamper.
      allow write: if false;
    }

    match /wordList/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}

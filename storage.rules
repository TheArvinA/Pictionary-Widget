rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    match /rounds/{date}/{drawerId}.png {
      allow read: if isSignedIn()
        && firestore.exists(/databases/(default)/documents/rounds/$(date)/players/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/rounds/$(date)/players/$(request.auth.uid)).data.hasSubmittedDrawing == true;

      allow write: if isSignedIn()
        && request.auth.uid == drawerId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/png';
    }
  }
}
